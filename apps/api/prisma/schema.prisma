generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ORGANIZATIONS (Multi-Tenant Workspace)
// ==========================================
model Organization {
  id           String       @id @default(uuid())
  name         String
  businessType String?      @default("CONTRACTOR")
  phone        String?      @default("")
  gstin        String?      @default("")
  pan          String?      @default("")
  address      String?      @default("")
  city         String?      @default("")
  state        String?      @default("")
  pincode      String?      @default("")
  currency     String       @default("INR")
  logo         String?      @default("")
  revision     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  users        User[]
  sites        Site[]
  workers      Worker[]
  suppliers    Supplier[]
  attendances  Attendance[]
  entries      Entry[]
  attachments  Attachment[]
  audits       Audit[]
  requests     Request[]
}

// ==========================================
// 2. USERS & ROLES
// ==========================================
model User {
  id           String       @id @default(uuid())
  orgId        String
  name         String
  email        String       @unique
  phone        String?      @default("")
  passwordHash String
  role         String       @default("OWNER") // OWNER, SUPERVISOR, ACCOUNTANT
  active       Boolean      @default(true)
  avatar       String?      @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions     Session[]
  audits       Audit[]
  attachments  Attachment[]
}

// ==========================================
// 3. SESSIONS
// ==========================================
model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. SITES (Work / Theka Sites)
// ==========================================
model Site {
  id                String       @id @default(uuid())
  orgId             String
  name              String
  ownerName         String
  phone             String       @default("")
  email             String?      @default("")
  address           String       @default("")
  city              String?      @default("")
  pincode           String?      @default("")
  geoLat            Decimal?     @db.Decimal(10, 7)
  geoLng            Decimal?     @db.Decimal(10, 7)
  workType          String       // LABOUR, MATERIAL
  pricing           String       // FIXED, UNIT, DAILY
  contractAmount    Decimal      @default(0) @db.Decimal(15, 2)
  quantity          Decimal      @default(1) @db.Decimal(12, 3)
  unit              String       @default("job")
  unitRate          Decimal      @default(0) @db.Decimal(15, 2)
  remainingEstimate Decimal      @default(0) @db.Decimal(15, 2)
  materialBudget    Decimal?     @default(0) @db.Decimal(15, 2)
  labourBudget      Decimal?     @default(0) @db.Decimal(15, 2)
  status            String       @default("ONGOING") // UPCOMING, ONGOING, PAUSED, COMPLETED
  startDate         DateTime
  endDate           DateTime?
  notes             String       @default("")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendances       Attendance[]
  entries           Entry[]
  attachments       Attachment[]

  @@unique([orgId, id])
  @@index([orgId, status])
}

// ==========================================
// 5. WORKERS (Labour / Karigar)
// ==========================================
model Worker {
  id               String       @id @default(uuid())
  orgId            String
  name             String
  phone            String       @default("")
  skill            String       // HELPER, MASON, CARPENTER, PLUMBER, ELECTRICIAN, PAINTER, OTHER
  dailyRate        Decimal      @default(0) @db.Decimal(15, 2)
  overtimeRate     Decimal      @default(0) @db.Decimal(15, 2)
  aadhaarNumber    String?
  upiId            String?
  bankAccount      String?
  ifscCode         String?
  bankName         String?
  emergencyContact String?
  address          String?      @default("")
  photo            String       @default("")
  active           Boolean      @default(true)
  notes            String?      @default("")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendances      Attendance[]
  entries          Entry[]
  attachments      Attachment[]

  @@unique([orgId, id])
  @@index([orgId, active])
}

// ==========================================
// 6. SUPPLIERS (Material Dukandaar / Vendors)
// ==========================================
model Supplier {
  id             String       @id @default(uuid())
  orgId          String
  name           String
  phone          String       @default("")
  category       String       @default("MATERIAL")
  shopName       String?
  gstin          String?      @default("")
  address        String?      @default("")
  upiId          String?
  bankAccount    String?
  ifscCode       String?
  openingBalance Decimal      @default(0) @db.Decimal(15, 2)
  notes          String?      @default("")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries        Entry[]
  attachments    Attachment[]

  @@unique([orgId, id])
  @@index([orgId, active])
}

// ==========================================
// 7. ATTENDANCE (Daily Haziri)
// ==========================================
model Attendance {
  id              String       @id @default(uuid())
  orgId           String
  siteId          String
  workerId        String
  date            DateTime
  units           Decimal      @db.Decimal(3, 2) // 0, 0.5, 1, 1.5
  overtimeMinutes Int          @default(0)
  dailyRate       Decimal      @default(0) @db.Decimal(15, 2)
  overtimeRate    Decimal      @default(0) @db.Decimal(15, 2)
  amount          Decimal      @default(0) @db.Decimal(15, 2)
  checkInTime     DateTime?
  checkOutTime    DateTime?
  notes           String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker          Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([orgId, siteId, workerId, date])
  @@index([orgId, workerId, date])
  @@index([orgId, siteId, date])
}

// ==========================================
// 8. ENTRIES (Financial Ledger & Bills)
// ==========================================
model Entry {
  id            String       @id @default(uuid())
  orgId         String
  siteId        String
  workerId      String?
  supplierId    String?
  kind          String       // RECEIPT, WAGE_PAYMENT, MATERIAL, EXPENSE, EXTRA, SUPPLIER_PAYMENT
  category      String?      @default("GENERAL")
  date          DateTime
  amount        Decimal      @db.Decimal(15, 2)
  description   String
  party         String       @default("")
  mode          String       @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, RECORD
  reference     String       @default("")
  invoiceNumber String?
  dueDate       DateTime?
  linkedEntryId String?
  quantity      Decimal?     @db.Decimal(12, 3)
  unit          String?
  unitRate      Decimal?     @db.Decimal(15, 2)
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker        Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  supplier      Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  linkedEntry   Entry?       @relation("LinkedEntries", fields: [linkedEntryId], references: [id], onDelete: SetNull)
  childEntries  Entry[]      @relation("LinkedEntries")
  attachments   Attachment[]

  @@unique([orgId, id])
  @@index([orgId, siteId, date])
  @@index([orgId, kind, date])
  @@index([orgId, workerId])
  @@index([orgId, supplierId])
}

// ==========================================
// 9. ATTACHMENTS (Bills, Receipts & Docs)
// ==========================================
model Attachment {
  id           String       @id @default(uuid())
  orgId        String
  siteId       String?
  workerId     String?
  supplierId   String?
  entryId      String?
  fileName     String
  fileUrl      String
  mimeType     String       @default("application/octet-stream")
  fileSize     Int          @default(0)
  uploadedById String?
  createdAt    DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  worker       Worker?      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  entry        Entry?       @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([siteId])
  @@index([workerId])
  @@index([supplierId])
  @@index([entryId])
}

// ==========================================
// 10. AUDIT TRAIL
// ==========================================
model Audit {
  id         String       @id @default(uuid())
  orgId      String
  userId     String
  action     String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ==========================================
// 11. IDEMPOTENCY REQUESTS
// ==========================================
model Request {
  orgId     String
  key       String
  hash      String
  result    Json
  createdAt DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
}
